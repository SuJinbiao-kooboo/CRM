    <sql id="Base_Column_List">
        s.id, s.supplier_code, s.supplier_name, s.supplier_short_name, s.supplier_alias, s.supplier_type, s.brands,
        s.country, s.address, s.website, s.main_products, s.cooperation_level, s.risk_level,
        s.payment_terms, s.cooperation_status, s.business_license, s.tax_number, s.bank_info, s.bank_account, s.bill_to, s.ship_to,
        s.introduction, s.remark, s.remark_second, s.status, s.follow_up_by, s.create_by, s.create_time,
        s.update_by, s.update_time, s.tags_first, s.tags_second, s.tags_third, s.tags_si,
        s.last_follow_up_time, s.last_follow_up_result, s.next_follow_up_time, s.next_follow_up_goal
    </sql>

    <select id="selectSupplierListJoined" parameterType="com.ruoyi.crm.domain.CrmSupplier" resultMap="CrmSupplierMap">
        select
        <include refid="Base_Column_List"/>,
        <!-- 跟进人显示名称：登录名转昵称（存储为登录名保证唯一，展示用昵称） -->
        (select group_concat(u.nick_name order by find_in_set(u.user_name, s.follow_up_by) separator ',') from sys_user u where find_in_set(u.user_name, s.follow_up_by) > 0) as follow_up_by_names,
        c.contact_name as contact_name, c.post as post, c.phone as phone, c.email as email, c.qq as teams, c.whatsapp, c.other_contact_first,  c.other_contact_second,c.remark_first, c.remark_second
        from crm_supplier s
        left join crm_supplier_contact c on c.supplier_id = s.id
        <where>
            <if test="supplierCode != null and supplierCode != ''">
                and s.supplier_code like concat('%', #{supplierCode}, '%')
            </if>
            <if test="supplierName != null and supplierName != ''">
                and s.supplier_name like concat('%', #{supplierName}, '%')
            </if>
            <if test="supplierAlias != null and supplierAlias != ''">
                and s.supplier_alias like concat('%', #{supplierAlias}, '%')
            </if>
            <if test="contactName != null and contactName != ''">
                and c.contact_name like concat('%', #{contactName}, '%')
            </if>
            <if test="params != null and params['supplierTypeList'] != null and params['supplierTypeList'].length() > 0">
                and (
                <foreach collection="params.supplierTypeList.split(',')" item="t" separator=" or ">
                    s.supplier_type like concat('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="params != null and params['brandsList'] != null and params['brandsList'].length() > 0">
                and (
                <foreach collection="params.brandsList.split(',')" item="t" separator=" or ">
                    s.brands like concat('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="params != null and params['mainProductsList'] != null and params['mainProductsList'].length() > 0">
                and (
                <foreach collection="params.mainProductsList.split(',')" item="t" separator=" or ">
                    s.main_products like concat('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="params != null and params['cooperationLevelList'] != null and params['cooperationLevelList'].length() > 0">
                and (
                <foreach collection="params.cooperationLevelList.split(',')" item="t" separator=" or ">
                    s.cooperation_level like concat('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="params != null and params['riskLevelList'] != null and params['riskLevelList'].length() > 0">
                and (
                <foreach collection="params.riskLevelList.split(',')" item="t" separator=" or ">
                    s.risk_level like concat('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="params != null and params['paymentTermsList'] != null and params['paymentTermsList'].length() > 0">
                and (
                <foreach collection="params.paymentTermsList.split(',')" item="t" separator=" or ">
                    s.payment_terms like concat('%', #{t}, '%')
                </foreach>
                )
            </if>
            <if test="tagsFirst != null and tagsFirst != ''">and s.tags_first like concat('%', #{tagsFirst}, '%')</if>
            <if test="tagsSecond != null and tagsSecond != ''">and s.tags_second like concat('%', #{tagsSecond}, '%')</if>
            <if test="tagsThird != null and tagsThird != ''">and s.tags_third like concat('%', #{tagsThird}, '%')</if>
            <if test="tagsSi != null and tagsSi != ''">and s.tags_si like concat('%', #{tagsSi}, '%')</if>
            <if test="cooperationStatus != null and cooperationStatus != ''">and s.cooperation_status = #{cooperationStatus}</if>
            <if test="params != null and params['beginTime'] != null">
                and s.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params != null and params['endTime'] != null">
                and s.create_time &lt;= #{params.endTime}
            </if>
            <if test="status != null">and s.status = #{status}</if>
            <!-- 数据权限：非管理员/超级管理员仅能查看跟进人包含当前登录用户的供应商 -->
            <if test="params != null and params['permUserName'] != null and params['permUserName'] != ''">
                and find_in_set(#{params.permUserName}, s.follow_up_by) > 0
            </if>
        </where>
        order by s.create_time desc
    </select>

    <select id="selectSupplierById" parameterType="long" resultMap="CrmSupplierBaseMap">
        select <include refid="Base_Column_List"/> from crm_supplier s where s.id = #{id}
    </select>

    <!-- 按编码查询供应商（AI录入/批量导入提交时的数据权限校验用） -->
    <select id="selectSupplierByCode" resultMap="CrmSupplierBaseMap">
        select <include refid="Base_Column_List"/> from crm_supplier s where s.supplier_code = #{supplierCode} limit 1
    </select>

    <!-- 供应商编号查重：同时统计供应商表与Offer表中占用该编码的记录数（自动生成编号时保证唯一） -->
    <select id="countBySupplierCode" resultType="int">
        select (select count(*) from crm_supplier where supplier_code = #{supplierCode})
             + (select count(*) from crm_offer where supplier_code = #{supplierCode})
    </select>

    <insert id="insertSupplier" parameterType="com.ruoyi.crm.domain.CrmSupplier" useGeneratedKeys="true" keyProperty="id">
        insert into crm_supplier(
            supplier_code, supplier_name, supplier_short_name, supplier_alias, supplier_type, brands,
            country, address, website, main_products, cooperation_level, risk_level,
            payment_terms, cooperation_status, business_license, tax_number, bank_info, bank_account, bill_to, ship_to,
            introduction, remark, remark_second, status, follow_up_by, create_by, create_time,
            update_by, update_time, tags_first, tags_second, tags_third, tags_si
        ) values(
            #{supplierCode}, #{supplierName}, #{supplierShortName}, #{supplierAlias}, #{supplierType}, #{brands},
            #{country}, #{address}, #{website}, #{mainProducts}, #{cooperationLevel}, #{riskLevel},
            #{paymentTerms}, #{cooperationStatus}, #{businessLicense}, #{taxNumber}, #{bankInfo}, #{bankAccount}, #{billTo}, #{shipTo},
            #{introduction}, #{remark}, #{remarkSecond}, #{status}, #{followUpBy}, #{createBy}, now(),
            #{updateBy}, now(), #{tagsFirst}, #{tagsSecond}, #{tagsThird}, #{tagsSi}
        )
    </insert>

    <update id="updateSupplier" parameterType="com.ruoyi.crm.domain.CrmSupplier">
        update crm_supplier
        <set>
            <if test="supplierCode != null">supplier_code = #{supplierCode},</if>
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="supplierShortName != null">supplier_short_name = #{supplierShortName},</if>
            <if test="supplierAlias != null">supplier_alias = #{supplierAlias},</if>
            <if test="supplierType != null">supplier_type = #{supplierType},</if>
            <if test="brands != null">brands = #{brands},</if>
            <if test="country != null">country = #{country},</if>
            <if test="address != null">address = #{address},</if>
            <if test="website != null">website = #{website},</if>
            <if test="mainProducts != null">main_products = #{mainProducts},</if>
            <if test="cooperationLevel != null">cooperation_level = #{cooperationLevel},</if>
            <if test="riskLevel != null">risk_level = #{riskLevel},</if>
            <if test="paymentTerms != null">payment_terms = #{paymentTerms},</if>
            <if test="cooperationStatus != null">cooperation_status = #{cooperationStatus},</if>
            <if test="businessLicense != null">business_license = #{businessLicense},</if>
            <if test="taxNumber != null">tax_number = #{taxNumber},</if>
            <if test="bankInfo != null">bank_info = #{bankInfo},</if>
            <if test="bankAccount != null">bank_account = #{bankAccount},</if>
            <if test="billTo != null">bill_to = #{billTo},</if>
            <if test="shipTo != null">ship_to = #{shipTo},</if>
            <if test="introduction != null">introduction = #{introduction},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="remarkSecond != null">remark_second = #{remarkSecond},</if>
            <if test="status != null">status = #{status},</if>
            <if test="followUpBy != null">follow_up_by = #{followUpBy},</if>
            update_by = #{updateBy},
            update_time = now(),
            <if test="tagsFirst != null">tags_first = #{tagsFirst},</if>
            <if test="tagsSecond != null">tags_second = #{tagsSecond},</if>
            <if test="tagsThird != null">tags_third = #{tagsThird},</if>
            <if test="tagsSi != null">tags_si = #{tagsSi}</if>
        </set>
        where id = #{id}
    </update>

    <update id="updateFollowUp" parameterType="com.ruoyi.crm.domain.CrmSupplier">
        <!-- 写跟进：全量覆盖跟进记录字段（时间/结论/目标），支持将已填时间清空；仅列表右侧"写跟进"弹窗调用 -->
        update crm_supplier
        set last_follow_up_time = #{lastFollowUpTime},
            last_follow_up_result = #{lastFollowUpResult},
            next_follow_up_time = #{nextFollowUpTime},
            next_follow_up_goal = #{nextFollowUpGoal},
            update_by = #{updateBy},
            update_time = now()
        where id = #{id}
    </update>

    <select id="selectSupplierOptions" parameterType="com.ruoyi.crm.domain.CrmSupplier" resultType="com.ruoyi.crm.domain.CrmSupplier">
        select min(s.id) as id, s.supplier_code as supplier_code, s.supplier_name as supplier_name, group_concat(distinct ifnull(s.supplier_alias, '') separator '/') as supplier_alias
        from crm_supplier s
        <where>
            <!-- 支持按供应商编码、名称或别名模糊搜索（Offer页面供应商选择均显示编码，故编码需可搜） -->
            <if test="supplierName != null and supplierName != ''">and (s.supplier_name like concat('%', #{supplierName}, '%') or s.supplier_alias like concat('%', #{supplierName}, '%') or s.supplier_code like concat('%', #{supplierName}, '%'))</if>
            <if test="supplierCode != null and supplierCode != ''">and s.supplier_code like concat('%', #{supplierCode}, '%')</if>
            <!-- 数据权限：非管理员/超级管理员仅能选择跟进人包含当前登录用户的供应商 -->
            <if test="params != null and params['permUserName'] != null and params['permUserName'] != ''">
                and find_in_set(#{params.permUserName}, s.follow_up_by) > 0
            </if>
        </where>
        group by s.supplier_code, s.supplier_name
        order by s.supplier_code asc
    </select>

    <select id="selectSupplierSimpleList" parameterType="com.ruoyi.crm.domain.CrmSupplier" resultMap="CrmSupplierBaseMap">
        select id, supplier_code, supplier_name from crm_supplier
        <where>
            <if test="params != null and params.keyword != null and params.keyword != ''">
                and (supplier_code like concat('%', #{params.keyword}, '%') or supplier_name like concat('%', #{params.keyword}, '%'))
            </if>
            <!-- 数据权限：非管理员/超级管理员仅能查询跟进人包含当前登录用户的供应商 -->
            <if test="params != null and params['permUserName'] != null and params['permUserName'] != ''">
                and find_in_set(#{params.permUserName}, follow_up_by) > 0
            </if>
        </where>
        order by supplier_code asc
    </select>

    <!-- 跟进人昵称解析：登录名转昵称（存储为登录名保证唯一，展示用昵称，保持存储顺序） -->
    <select id="selectNickNamesByUserNames" resultType="java.lang.String">
        select u.nick_name from sys_user u
        where u.del_flag = '0' and find_in_set(u.user_name, #{userNames}) > 0
        order by find_in_set(u.user_name, #{userNames})
    </select>

    <!-- 跟进人选择数据源：当前系统启用用户（存登录名userName，显示昵称nickName） -->
    <select id="selectUserOptions" resultType="java.util.HashMap">
        select user_id as userId, user_name as userName, nick_name as nickName
        from sys_user
        where del_flag = '0' and status = '0'
        <if test="keyword != null and keyword != ''">
            and (user_name like concat('%', #{keyword}, '%') or nick_name like concat('%', #{keyword}, '%'))
        </if>
        order by user_id asc
    </select>

    <delete id="deleteSupplierByIds" parameterType="long">
        delete from crm_supplier where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="deleteSupplierById" parameterType="long">
        delete from crm_supplier where id = #{id}
    </delete>

    <delete id="deleteContactsBySupplierId" parameterType="long">
        delete from crm_supplier_contact where supplier_id = #{supplierId}
    </delete>

    <delete id="deleteAttachmentsBySupplier">
        delete from crm_attachment where from_type = #{fromType} and from_id = #{fromId}
    </delete>


    <!-- 批量插入，支持默认值 -->
    <insert id="batchInsertWithDefault">
        INSERT INTO crm_send_email_task
        (batch_no, email, result, update_time)
        VALUES
        <foreach collection="emailList" item="email" separator=",">
            (
            #{batchNo},
            #{email},
            '未发送',
            NOW()
            )
        </foreach>
    </insert>
    <!-- 批量插入，支持默认值 -->
    <insert id="deleteAllTask">
        delete from crm_send_email_task where 1=1;
    </insert>
    <!-- 批量插入，支持默认值 -->
    <insert id="updateSendResult">
        update crm_send_email_task set result=#{result},msg=#{msg} where email=#{email};
    </insert>
    <!-- 批量插入，支持默认值 -->
    <select id="selectEmailResultList" resultType="com.ruoyi.crm.domain.dto.CrmSendEmailTaskDTO">
        select * from crm_send_email_task order by update_time desc;
    </select>
    <!-- 批量插入，支持默认值 -->
    <select id="selectSubscribeEmailList" resultType="com.ruoyi.crm.domain.dto.SubscribeEmailDTO">
        select * from portal.t_subscription;
    </select>

</mapper>
